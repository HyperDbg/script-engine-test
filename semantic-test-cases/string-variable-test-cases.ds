? {

  //
  // Test case activation
  //
  test_case93 = 1;
  test_case94 = 1;
  test_case95 = 1;
  test_case96 = 1;
  test_case97 = 1;
  test_case98 = 1;
  test_case99 = 1;
  test_case100 = 1;
  test_case101 = 1;
  test_case102 = 1;
  test_case103 = 1;
  test_case104 = 1;

  //
  // Test case configuration
  //
  current_test_case = 0n92;

  /* ======================================================================= */

  //
  // Test case 93 (inferred char array from a string literal)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case93 != 1) {
      break;
    }

    char text[] = "123456";

    if (strlen(text) == 6 && sizeof(text) == 7 &&
        text[0] == '1' && text[5] == '6' && text[6] == 0) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 94 (inferred wchar_t array uses the fixed UTF-16 ABI)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case94 != 1) {
      break;
    }

    wchar_t wide_text[] = L"ABCD";

    if (wcslen(wide_text) == 4 && sizeof(wide_text) == 0n10 &&
        sizeof(wide_text[0]) == 2 && wide_text[0] == L'A' &&
        wide_text[3] == L'D' && wide_text[4] == 0) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 95 (uninitialized fixed arrays are zero-filled)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case95 != 1) {
      break;
    }

    char empty_text[32];
    wchar_t empty_wide_text[32];

    if (strlen(empty_text) == 0 && wcslen(empty_wide_text) == 0 &&
        empty_text[0] == 0 && empty_text[31] == 0 &&
        empty_wide_text[0] == 0 && empty_wide_text[31] == 0) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 96 (fixed string arrays zero-fill their tails)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case96 != 1) {
      break;
    }

    char fixed_text[8] = "abc";
    char exact_text[4] = "abc";
    wchar_t fixed_wide_text[8] = L"abc";
    wchar_t exact_wide_text[4] = L"abc";

    if (strlen(fixed_text) == 3 && wcslen(fixed_wide_text) == 3 &&
        strlen(exact_text) == 3 && wcslen(exact_wide_text) == 3 &&
        fixed_text[3] == 0 && fixed_text[7] == 0 &&
        fixed_wide_text[3] == 0 && fixed_wide_text[7] == 0) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 97 (inferred initializer lists do not add a terminator)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case97 != 1) {
      break;
    }

    char listed_text[] = {'a', 'b', 0};
    char unterminated_text[] = {'x', 'y'};
    wchar_t listed_wide_text[] = {L'a', L'b', 0};

    if (sizeof(listed_text) == 3 && sizeof(unterminated_text) == 2 &&
        sizeof(listed_wide_text) == 6 && listed_text[1] == 'b' &&
        unterminated_text[1] == 'y' && listed_wide_text[1] == L'b') {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 98 (runtime initializer expressions and fixed-tail zeroing)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case98 != 1) {
      break;
    }

    char first = 'A';
    wchar_t wide_first = L'A';
    char runtime_text[5] = {first, first + 1, 0};
    wchar_t runtime_wide_text[5] = {wide_first, wide_first + 1, 0};

    if (runtime_text[0] == 'A' && runtime_text[1] == 'B' &&
        runtime_text[2] == 0 && runtime_text[4] == 0 &&
        runtime_wide_text[0] == L'A' && runtime_wide_text[1] == L'B' &&
        runtime_wide_text[2] == 0 && runtime_wide_text[4] == 0) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 99 (narrow stores and typed loads)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case99 != 1) {
      break;
    }

    char narrow_text[] = {0x1ff, 0};
    wchar_t narrow_wide_text[] = {0x12345, 0};

    if (narrow_text[0] == -1 && narrow_wide_text[0] == 0x2345) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 100 (array index writes mutate string storage)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case100 != 1) {
      break;
    }

    char mutable_text[] = "abc";
    wchar_t mutable_wide_text[] = L"abc";

    mutable_text[0] = 'X';
    mutable_text[1] = 0x159;
    mutable_wide_text[0] = L'X';
    mutable_wide_text[1] = 0x10059;

    if (mutable_text[0] == 'X' && mutable_text[1] == 'Y' &&
        mutable_wide_text[0] == L'X' && mutable_wide_text[1] == L'Y') {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 101 (array-to-pointer decay works with existing builtins)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case101 != 1) {
      break;
    }

    char decay_text[] = "123456";
    wchar_t decay_wide_text[] = L"123456";
    char *text_pointer = decay_text;
    wchar_t *wide_text_pointer = decay_wide_text;

    if (strlen(text_pointer) == 6 && strlen(decay_text + 2) == 4 &&
        wcslen(wide_text_pointer) == 6 && wcslen(decay_wide_text + 2) == 4) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 102 (char pointer indexing and dereference writes)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case102 != 1) {
      break;
    }

    char pointer_text[] = "abcd";
    char *char_pointer = pointer_text;

    char_pointer[0] = 'W';
    *(char_pointer + 1) = 'X';
    *(char_pointer + 2) = 'Y';

    if (pointer_text[0] == 'W' && pointer_text[1] == 'X' &&
        pointer_text[2] == 'Y' && char_pointer + 3 - char_pointer == 3) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 103 (wchar_t pointer arithmetic scales by two bytes)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case103 != 1) {
      break;
    }

    wchar_t wide_pointer_text[] = L"abcd";
    wchar_t *wide_pointer = wide_pointer_text;

    wide_pointer[0] = L'W';
    *(wide_pointer + 1) = L'X';
    *(wide_pointer + 2) = L'Y';

    if (wide_pointer_text[0] == L'W' && wide_pointer_text[1] == L'X' &&
        wide_pointer_text[2] == L'Y' &&
        wide_pointer + 3 - wide_pointer == 3) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 104 (separate arrays own independent mutable storage)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case104 != 1) {
      break;
    }

    char first_text[] = "same";
    char second_text[] = "same";
    wchar_t first_wide_text[] = L"same";
    wchar_t second_wide_text[] = L"same";

    first_text[0] = 'S';
    first_wide_text[0] = L'S';

    if (first_text[0] == 'S' && second_text[0] == 's' &&
        first_wide_text[0] == L'S' && second_wide_text[0] == L's') {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

}
