? {

  //
  // Test case activation
  //
  test_case70 = 1;
  test_case71 = 1;
  test_case72 = 1;
  test_case73 = 1;
  test_case74 = 1;
  test_case75 = 1;
  test_case76 = 1;
  test_case77 = 1;
  test_case78 = 1;
  test_case79 = 1;
  test_case80 = 1;
  test_case81 = 1;

  //
  // Test case configuration
  //
  current_test_case = 0n69;

  /* ======================================================================= */

  //
  // Test case 70 (struct member as a printf argument)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case70 != 1) {
      break;
    }

    struct PointPrintf {
      int x;
      int y;
    };

    struct PointPrintf printf_point = {1, 0n70};
    printf_point.x = 20;

    if (printf_point.x == 20 && printf_point.y == current_test_case) {
      printf("test case %d was successful\n", printf_point.y);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 71 (struct member state)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case71 != 1) {
      break;
    }

    struct PointState {
      int x;
      int y;
    };

    struct PointState state_point = {1, 2};
    state_point.x = 20;

    if (state_point.x == 20 && state_point.y == 2) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 72 (struct initializer and member arithmetic)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case72 != 1) {
      break;
    }

    struct PointArithmetic {
      int x;
      int y;
    };

    struct PointArithmetic arithmetic_point = {10, 20};
    arithmetic_point.x = arithmetic_point.x + 5;
    arithmetic_point.y = arithmetic_point.y * 2;

    if (arithmetic_point.x == 15 && arithmetic_point.y == 40) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 73 (whole-struct copy)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case73 != 1) {
      break;
    }

    struct PairCopy {
      int first;
      int second;
    };

    struct PairCopy copy_source = {11, 22};
    struct PairCopy copy_destination;

    copy_destination = copy_source;
    copy_source.first = 99;

    if (copy_destination.first == 11 &&
        copy_destination.second == 22 &&
        copy_source.first == 99) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 74 (nested struct members)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case74 != 1) {
      break;
    }

    struct NestedCoordinates {
      int x;
      int y;
    };

    struct NestedRectangle {
      struct NestedCoordinates top_left;
      struct NestedCoordinates bottom_right;
    };

    struct NestedRectangle rectangle;
    rectangle.top_left.x = 5;
    rectangle.top_left.y = 2;
    rectangle.bottom_right.x = 30;
    rectangle.bottom_right.y = 50;

    if (rectangle.top_left.x == 5 &&
        rectangle.top_left.y == 2 &&
        rectangle.bottom_right.x == 30 &&
        rectangle.bottom_right.y == 50) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 75 (partial initializer zero-fill)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case75 != 1) {
      break;
    }

    struct PartialValues {
      int first;
      int second;
      int third;
    };

    struct PartialValues partial_values = {7};

    if (partial_values.first == 7 &&
        partial_values.second == 0 &&
        partial_values.third == 0) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 76 (1/2/4/8-byte scalar members)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case76 != 1) {
      break;
    }

    struct ScalarWidths {
      char byte_value;
      short word_value;
      int dword_value;
      long qword_value;
    };

    struct ScalarWidths scalar_values = {
      0x12,
      0x3456,
      0x789abcde,
      0x1122334455667788
    };

    scalar_values.byte_value = 0x21;
    scalar_values.word_value = 0x6543;

    if (scalar_values.byte_value == 0x21 &&
        scalar_values.word_value == 0x6543 &&
        scalar_values.dword_value == 0x789abcde &&
        scalar_values.qword_value == 0x1122334455667788) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 77 (local struct pointer member read)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case77 != 1) {
      break;
    }

    struct ArrowRead {
      int value;
    };

    struct ArrowRead arrow_read = {0n77};
    struct ArrowRead *arrow_read_pointer;
    arrow_read_pointer = &arrow_read;

    if (arrow_read_pointer->value == current_test_case) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 78 (local struct pointer member write)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case78 != 1) {
      break;
    }

    struct ArrowWrite {
      int value;
    };

    struct ArrowWrite arrow_write = {0};
    struct ArrowWrite *arrow_write_pointer;
    arrow_write_pointer = &arrow_write;
    arrow_write_pointer->value = current_test_case;

    if (arrow_write.value == current_test_case &&
        arrow_write_pointer->value == current_test_case) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 79 (1/2/4/8-byte members through a struct pointer)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case79 != 1) {
      break;
    }

    struct ArrowWidths {
      char byte_value;
      short word_value;
      int dword_value;
      long qword_value;
    };

    struct ArrowWidths arrow_widths = {0, 0, 0, 0};
    struct ArrowWidths *arrow_widths_pointer;
    arrow_widths_pointer = &arrow_widths;
    arrow_widths_pointer->byte_value = 0x12;
    arrow_widths_pointer->word_value = 0x3456;
    arrow_widths_pointer->dword_value = 0x789abcde;
    arrow_widths_pointer->qword_value = 0x1122334455667788;

    if (arrow_widths.byte_value == 0x12 &&
        arrow_widths.word_value == 0x3456 &&
        arrow_widths.dword_value == 0x789abcde &&
        arrow_widths.qword_value == 0x1122334455667788 &&
        arrow_widths_pointer->byte_value == 0x12 &&
        arrow_widths_pointer->word_value == 0x3456 &&
        arrow_widths_pointer->dword_value == 0x789abcde &&
        arrow_widths_pointer->qword_value == 0x1122334455667788) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 80 (nested member access through a struct pointer)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case80 != 1) {
      break;
    }

    struct ArrowNestedValue {
      int value;
    };

    struct ArrowNestedContainer {
      struct ArrowNestedValue nested;
    };

    struct ArrowNestedContainer arrow_nested;
    struct ArrowNestedContainer *arrow_nested_pointer;
    arrow_nested_pointer = &arrow_nested;
    arrow_nested_pointer->nested.value = current_test_case;

    if (arrow_nested.nested.value == current_test_case &&
        arrow_nested_pointer->nested.value == current_test_case) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

  /* ======================================================================= */

  //
  // Test case 81 (recursive struct pointer and dereference equivalence)
  //
  current_test_case = current_test_case + 1;

  do {

    if (test_case81 != 1) {
      break;
    }

    struct RecursiveNode;

    struct RecursiveNode {
      int value;
      struct RecursiveNode *next;
    };

    struct RecursiveNode recursive_node;
    struct RecursiveNode *recursive_node_pointer;
    recursive_node.value = current_test_case;
    recursive_node_pointer = &recursive_node;

    if (recursive_node_pointer->value == current_test_case &&
        (*recursive_node_pointer).value == current_test_case) {
      printf("test case %d was successful\n", current_test_case);
    } else {
      printf("test case %d was failed\n", current_test_case);
    }

  }
  while (0);

}
